{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "touch \"${CLAUDE_PROJECT_DIR:-.}/.claude/.claude-edited\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-gate.sh\"",
            "timeout": 30,
            "statusMessage": "Comprobando cambios de código sin revisar…"
          }
        ]
      }
    ]
  }
}
